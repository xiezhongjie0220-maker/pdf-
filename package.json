{
  "name": "pdf-compressor",
  "version": "1.5.0",
  "description": "PDF 批量压缩助手 - 极简苹果风格 Windows 桌面应用",
  "main": "main.js",
  "author": "WorkBuddy User",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.workbuddy.pdf-compressor",
    "productName": "PDF 压缩助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "compressor.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/ghostscript",
        "to": "ghostscript",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF 压缩助手"
    }
  }
}
